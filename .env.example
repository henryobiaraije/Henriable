# Local Anvil Configuration
ANVIL_RPC_URL=http://127.0.0.1:8545
# Using Anvil Account (0) Private Key
ANVIL_PRIVATE_KEY="0xac..."

# Sepolia Testnet Configuration
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Private key of the account funding the Sepolia deployment
SEPOLIA_PRIVATE_KEY=0xYOUR_SEPOLIA_PRIVATE_KEY
# Etherscan API key used to verify the Sepolia deployment (optional)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY